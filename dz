Console.WriteLine("Введите строку: "); //(Шаг пятый)
string text = Console.ReadLine();

Console.OutputEncoding = Encoding.UTF8;
Console.InputEncoding = Encoding.UTF8;

int charCount = text.Length;
int textElementCount = 0;
var enumerator = StringInfo.GetTextElementEnumerator(text);
while (enumerator.MoveNext()) textElementCount++;


int russian = 0, latin = 0, digits = 0, spaces = 0, punctuation = 0, other = 0;

foreach (char c in text)
{
    if (IsRussianLetter(c)) russian++;
    else if (IsLatinLetter(c)) latin++;
    else if (char.IsDigit(c)) digits++;
    else if (char.IsWhiteSpace(c)) spaces++;
    else if (char.IsPunctuation(c) || char.IsSymbol(c)) punctuation++;
    else other++;
}

Console.WriteLine();
Console.WriteLine("--- Подсчёт символов (char, UTF-16 code units) ---");
Console.WriteLine($"Символов (char):       {charCount}");
Console.WriteLine($"Текстовых элементов:   {textElementCount}");
Console.WriteLine($"Байт в UTF-8:          {utf8Bytes}");
Console.WriteLine();
Console.WriteLine($"Русских букв:          {russian}");
Console.WriteLine($"Латинских букв:        {latin}");
Console.WriteLine($"Цифр:                  {digits}");
Console.WriteLine($"Пробелов:              {spaces}");
Console.WriteLine($"Знаков препинания:     {punctuation}");
Console.WriteLine($"Прочих символов:       {other}");

int expectedBytes = russian * 2 + (latin + digits + spaces + punctuation + other) * 1;

Console.WriteLine();
Console.WriteLine("--- Проверка правила ---");
Console.WriteLine($"Ожидаемое число байт:  {expectedBytes}");
Console.WriteLine($"Реальное число байт:   {utf8Bytes}");

int surrogatePairs = 0;
for (int i = 0; i < text.Length - 1; i++)
{
    if (char.IsHighSurrogate(text[i]) && char.IsLowSurrogate(text[i + 1]))
    {
        surrogatePairs++;
        i++;
    }
}
if (surrogatePairs > 0)
{
    Console.WriteLine();
    Console.WriteLine($"Обнаружено суррогатных пар (не-BMP символов): {surrogatePairs}");
    Console.WriteLine("Такие символы занимают 2 char в UTF-16 и 4 байта в UTF-8.");
}

static bool IsRussianLetter(char c)
{
    return (c >= '\u0410' && c <= '\u044F') || c == '\u0401' || c == '\u0451';
}

static bool IsLatinLetter(char c)
{
    return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z');
}


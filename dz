}
        
    

    static void DoOperation(string name, string operationName, Func<double, double, double> operation)
{
    try
    {
        Console.Write("Введите первое число: ");
        double a = double.Parse(Console.ReadLine());

        Console.Write("Введите второе число: ");
        double b = double.Parse(Console.ReadLine());

        double result = operation(a, b);
        Console.WriteLine($"Результат {operationName}: {result}");
    }
    catch (FormatException)
    {
        Console.WriteLine("Ошибка: введено не число. Возврат в меню.");
    }
    catch (DivideByZeroException ex)
    {
        Console.WriteLine($"Ошибка: {ex.Message}. Возврат в меню.");
    }
    catch (Exception ex)
    {
        Console.WriteLine($"Ошибка: {ex.Message}. Возврат в меню.");
    }
}

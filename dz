        DoOperation(name, "деления", (a, b) =>
        {
            if (b == 0) throw new DivideByZeroException("Деление на ноль невозможно");
            return a / b;
        });
        break;
    case "5":
        DoOperation(name, "возведения в степень", (a, b) => Math.Pow(a, b));
